# Contributions database (Neon, Supabase, Railway, etc.). Required on Streamlit Cloud.
# [database]
# url = "postgresql://user:password@host:5432/dbname?sslmode=require"

# Payment methods on the success page (enable any combination).
[payment]
phone_number = "+33612345678"
# Public URL of your personal Wero QR image (export from your banking app).
wero_qr_url = "https://example.com/wero-qr.png"
# PayPal.me base link (amount in EUR is appended automatically).
paypal_url = "https://paypal.me/yourname"
iban = "FR76 1234 5678 9012 3456 7890 123"
bic = "BNPAFRPP"
account_holder = "Loïc et Meriem"

[smtp]
host = "smtp.example.com"
port = 587
user = ""
password = ""
from_email = ""
notify_email = "you@example.com"
use_tls = true

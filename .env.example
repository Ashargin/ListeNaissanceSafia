# Copy to .env if your tooling loads it (Streamlit reads process env; optional).
SAFIA_DEBUG=0

# Public URL of this app. On Streamlit Cloud, use your *.streamlit.app URL.
SAFIA_APP_URL=<SAFIA_APP_URL>

# Payment methods on the success page (or use [payment] in secrets.toml).
# SAFIA_LYDIA_PHONE=+33612345678
# SAFIA_WERO_PHONE=+33612345678
# SAFIA_WERO_QR_URL=https://example.com/wero-qr.png
# SAFIA_PAYPAL_URL=https://paypal.me/yourname
# SAFIA_IBAN=FR7612345678901234567890123
# SAFIA_BIC=BNPAFRPP
# SAFIA_ACCOUNT_HOLDER=Loïc et Meriem

# Optional: override catalog path (defaults to ./data next to the repo root package).
# SAFIA_DATA_DIR=C:\path\to\data

# PostgreSQL for contributions (persists across redeploys). If unset, uses data/app.db locally.
# SAFIA_DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Optional: email via SMTP (or use [smtp] in .streamlit/secrets.toml instead).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_USE_TLS=1
# Your address for new-gift alerts (donor name, item, amount, optional message).
# SAFIA_NOTIFY_EMAIL=you@example.com
